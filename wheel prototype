import numpy as np

def memory_bounded_grover_simulation(num_nodes=10, num_colors=4, max_gb=10.0):
    total_states = num_colors ** num_nodes
    bytes_per_element = 1
    max_bytes = int(max_gb * 1024**3)

    max_elements_in_ram = max_bytes // (bytes_per_element * num_nodes)
    batch_size = min(total_states, max_elements_in_ram, 50_000_000)

    print(f" Total State Space: {total_states:,} configurations.")
    print(f"Memory Limit: {max_gb} GB ({max_bytes:,} bytes available).")
    print(f"Streaming Batch Size: {batch_size:,} states per chunk.")

    def vectorized_oracle(batch):
        hub_idx = num_nodes - 1
        hub_conflict = np.any(batch[:, :hub_idx] == batch[:, hub_idx:hub_idx+1], axis=1)

        perimeter_conflict = np.zeros(batch.shape[0], dtype=bool)
        for i in range(hub_idx):
            next_node = (i + 1) % hub_idx
            perimeter_conflict |= (batch[:, i] == batch[:, next_node])

        valid_mask = ~(hub_conflict | perimeter_conflict)
        return np.where(valid_mask)[0]

    color_names = {0: "🔴 Red", 1: "🔵 Blue", 2: "🟢 Green", 3: "🟡 Yellow"}
    max_grover_iterations = int(np.sqrt(float(total_states)))

    print(f"🚀 Sampling search space (Grover limit bound: ~{max_grover_iterations:,} checks)...")

    iterations_run = 0
    while iterations_run < max_grover_iterations:
        current_chunk_size = min(batch_size, max_grover_iterations - iterations_run)

        state_batch = np.random.randint(0, num_colors, size=(current_chunk_size, num_nodes), dtype=np.uint8)
        state_batch[:, -1] = 0

        hit_indices = vectorized_oracle(state_batch)

        if hit_indices.size > 0:
            winning_idx = hit_indices[0]
            winning_state = state_batch[winning_idx]

            print(f"\n [Oracle Hit!] Valid state found after scanning {iterations_run + winning_idx:,} states!")
            print("--- Final Quantum Register Map Results ---")
            print(f"👉 CENTRAL HUB NODE {num_nodes - 1} : {color_names[winning_state[-1]]}")
            for i in range(num_nodes - 1):
                print(f" Perimeter Node {i}     : {color_names[winning_state[i]]}")
            return True

        iterations_run += current_chunk_size
        del state_batch

    print(f"\n❌ Checked {iterations_run:,} states. No valid solution collapsed within this quantum allocation branch.")
    return False

memory_bounded_grover_simulation(num_nodes=21, num_colors=4, max_gb=12.0)
