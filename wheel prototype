def grover_simulation(num_nodes):
    total_states = 4 ** num_nodes
    qubits =  []
    for i in range(num_nodes):
        qubits.append(cirq.GridQubit(0,i))
        qubits.append(cirq.GridQubit(1,i))
    circuit = cirq.Circuit()
    circuit.append(cirq.H.on_each(qubits))
    ancilla = cirq.NamedQubit("ancilla")
    iters = int(np.sqrt(total_states))
    hub = 0
    encillas = [cirq.NamedQubit(f"edge {beep}") for beep in range(4*(num_nodes - 1))] #stands for edge ancillas
    circuit.append(cirq.X(ancilla))
    circuit.append(cirq.H(ancilla))
    for goat in range(iters):
      edge = 0
      #oracle
      for i in range(1,num_nodes):
        #hub checks
        circuit.append(cirq.CNOT(qubits[0],encillas[edge]))
        circuit.append(cirq.CNOT(qubits[2*i],encillas[edge]))
        circuit.append(cirq.CNOT(qubits[1],encillas[edge+1]))
        circuit.append(cirq.CNOT(qubits[2*i+1],encillas[edge+1]))

        circuit.append(cirq.X(encillas[edge]))
        circuit.append(cirq.X(encillas[edge+1]))

        edge+=2
        #outer ring checks
        if i == (num_nodes - 1):
          nextbro = 1
        else:
          nextbro = i + 1
        circuit.append(cirq.CNOT(qubits[2*i],encillas[edge]))
        circuit.append(cirq.CNOT(qubits[2*nextbro],encillas[edge]))
        circuit.append(cirq.CNOT(qubits[2*i + 1], encillas[edge+1]))
        circuit.append(cirq.CNOT(qubits[2*nextbro + 1], encillas[edge+1]))

        circuit.append(cirq.X(encillas[edge]))
        circuit.append(cirq.X(encillas[edge+1]))

        edge +=2

      circuit.append(cirq.X(ancilla).controlled_by(*encillas, control_values =[1] * len(encillas)))


      for i in reversed(range(1,num_nodes)):
        edge -=2
        if i == (num_nodes - 1):
          nextbro = 1
        else:
          nextbro = i + 1
        #outer ring undos
        circuit.append(cirq.X(encillas[edge+1]))
        circuit.append(cirq.X(encillas[edge]))
        circuit.append(cirq.CNOT(qubits[2*i],encillas[edge]))
        circuit.append(cirq.CNOT(qubits[2*nextbro],encillas[edge]))
        circuit.append(cirq.CNOT(qubits[2*i + 1], encillas[edge+1]))
        circuit.append(cirq.CNOT(qubits[2*nextbro + 1], encillas[edge+1]))
        #undo after ancilla records result
        edge-=2
        circuit.append(cirq.X(encillas[edge+1]))
        circuit.append(cirq.X(encillas[edge]))
        circuit.append(cirq.CNOT(qubits[0],encillas[edge]))
        circuit.append(cirq.CNOT(qubits[2*i],encillas[edge]))
        circuit.append(cirq.CNOT(qubits[1],encillas[edge+1]))
        circuit.append(cirq.CNOT(qubits[2*i+1],encillas[edge+1]))

    #diffuser
      circuit.append(cirq.H.on_each(qubits))
      circuit.append(cirq.X.on_each(qubits))
      circuit.append(cirq.Z(qubits[-1]).controlled_by(*qubits[: -1],control_values = [1]*(len(qubits)-1)))
      circuit.append(cirq.X.on_each(qubits))
      circuit.append(cirq.H.on_each(qubits))

    circuit.append(cirq.H(ancilla))
    circuit.append(cirq.X(ancilla))
    circuit.append(cirq.measure(qubits, key = "meep"))

    sim = cirq.Simulator()
    results = sim.run(circuit, repetitions = 1)
    listboi = results.measurements["meep"][0]

    colors = {0:"green",1:"cyan", 2:"orange", 3:"yellow"}
